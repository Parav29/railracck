<ShowLabel>true</ShowLabel>
<Body><![CDATA[int n = 0;
for (Crew c : crews) if (!c.busy) n++;
return n;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000469</Id>
<Name><![CDATA[writeResults]]></Name>
<Description><![CDATA[At the end of a run: append one KPI row to RakeFlow_runs.csv and write the per-cycle log (RAKE_cycle_log format).]]></Description>
<X>3180</X><Y>86</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[if (resultsWritten) return;
resultsWritten = true;
try {
    java.io.File f = new java.io.File("RakeFlow_runs.csv");
    boolean header = !f.exists();
    java.io.PrintWriter w = new java.io.PrintWriter(new java.io.FileWriter(f, true));
    if (header) {
        StringBuilder h = new StringBuilder("seed,phase,scenario,fleet,rakesPerDay,meanCycle_h,cycles,lineUtil,sidingUtil,tipplerUtil,demurrageRsPerRake,shareRelief,shareBpc,stockMinDays");
        for (int g = 0; g < GRP_NAME.length; g++) h.append(",grp_").append(GRP_NAME[g].replace(' ', '_'));
        h.append(",p90Cycle_h,tonnesPerDay,mergeQueueAvg,lineQueueAvg,crewExpiriesPer100Trips,examHoursPerRakeMonth");
        w.println(h);
    }
    StringBuilder s = new StringBuilder(String.format(java.util.Locale.US, "%d,%d,%d,%d,%.4f,%.3f,%d,%.4f,%.4f,%.4f,%.1f,%.4f,%.4f,%.2f",
        seed, cPhase, scenario, cFleet, rakesPerDay(), meanCycle(), cyclesDone, lineUtil(), sidingUtil(), tipplerUtil(),
        demurragePerRake(), shareRelief(), shareBpc(), stockMinDays));
    for (int g = 0; g < GRP_NAME.length; g++) s.append(String.format(java.util.Locale.US, ",%.3f", groupMean(g)));
    s.append(String.format(java.util.Locale.US, ",%.3f,%.0f,%.4f,%.4f,%.3f,%.3f", p90Cycle(), rakesPerDay() * payload_t,
        mergeQueueAvg(), lineQueueAvg(), crewExpiriesPer100(), examHoursPerRakeMonth()));
    w.println(s);
    w.close();
    if (writeCycleLog) {
        java.io.PrintWriter c = new java.io.PrintWriter(new java.io.FileWriter("RAKE_cycle_log_sim.csv", false));
        c.println(LOG_HEADER);
        for (String row : cycleLog) c.println(row);
        c.close();
    }
} catch (Exception e) {
    traceln("RakeFlow: could not write results: " + e);
}]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
<Id>1791000000470</Id>
<Name><![CDATA[tipplerColor]]></Name>
<Description><![CDATA[Tippler t: green = tippling, light grey = idle, dark grey = not in service (A-17).]]></Description>
<X>3180</X><Y>112</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[t]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[if (t >= cTipplers) return new java.awt.Color(110, 110, 110);
return tipplerUsed[t] ? new java.awt.Color(60, 170, 80) : new java.awt.Color(215, 215, 215);]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
<Id>1791000000471</Id>
<Name><![CDATA[sidingColor]]></Name>
<Description><![CDATA[Loading siding k: amber = loading, red = loaded rake blocking it, light = free, dark = not provided.]]></Description>
<X>3180</X><Y>138</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[k]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[if (k >= cSidings) return new java.awt.Color(110, 110, 110);
for (Rake r : rakes) if (r.sidingNo == k && r.onSiding) return r.phase == P_LOAD ? new java.awt.Color(235, 170, 40) : new java.awt.Color(200, 60, 60);
return new java.awt.Color(225, 225, 225);]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1791000000472</Id>
<Name><![CDATA[scenarioName]]></Name>
<Description><![CDATA[Short name of the active scenario preset (shown in the header line).]]></Description>
<X>3180</X><Y>164</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[String[] names = { "parameters as set", "RLS silo", "planned DN slot", "crew-critical priority", "Chandrapur lobby",
    "line doubling", "tipplers 3", "tipplers 5", "loops +1 GGS and TAE", "crew pool +20%", "sidings +1",
    "no through goods", "alternating dispatch", "batched dispatch", "crew during loading", "exam 3 days early",
    "exam 5 days early", "exam 7 days early", "exam at expiry", "baseline", "Exp 1 crew during loading",
    "Exp 2 third Ghugus loop", "Exp 3 RLS silo", "Exp 4 line doubling", "all three (crew + loop + RLS)",
    "crew + loop", "crew + RLS", "loop + RLS" };
return scenario >= 0 && scenario < names.length ? names[scenario] : "?";]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1791000000473</Id>
<Name><![CDATA[headerText]]></Name>
<Description><![CDATA[Clock and configuration line on the Main view.]]></Description>
<X>3180</X><Y>190</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[return String.format(java.util.Locale.US, "%s  |  day %.2f  |  phase %d (%s)  |  scenario %d: %s  |  fleet %d rakes  |  seed %d  |  %s",
    stampText(time()), time() / 24, cPhase, cPhase == 1 ? "core cycle" : cPhase == 2 ? "+ crew clock" : "+ crew + BPC",
    scenario, scenarioName(), cFleet, seed, time() < statsStart || statsStart == 0 ? "WARM-UP (stats not yet collected)" : "collecting statistics");]]></Body>
</Function>
</Functions>
