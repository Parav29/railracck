<Body><![CDATA[int m = (int) Math.round((x.t % 24) * 60) % 1440;
return String.format("%02d:%02d %s", m / 60, m % 60, x.kind == B_PAX ? x.label : x.kind == B_GOODS ? "goods" : x.label);]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[Rake]]></ReturnType>
<Id>1791000000457</Id>
<Name><![CDATA[rakeAt]]></Name>
<Description><![CDATA[Animation helper: rake with index i, or null.]]></Description>
<X>2920</X><Y>502</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[i]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[return i < rakes.size() ? rakes.get(i) : null;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000458</Id>
<Name><![CDATA[rakeProgress]]></Name>
<Description><![CDATA[0..1 progress through a moving phase.]]></Description>
<X>2920</X><Y>528</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[if (r.phaseEnd <= r.phaseStart) return 1;
return Math.max(0, Math.min(1, (time() - r.phaseStart) / (r.phaseEnd - r.phaseStart)));]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[int]]></ReturnType>
<Id>1791000000459</Id>
<Name><![CDATA[slotOf]]></Name>
<Description><![CDATA[Animation helper: position of r among rakes standing in the same place.]]></Description>
<X>2920</X><Y>554</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[kind]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[int n = 0;
for (Rake x : rakes) {
    if (x == r) return n;
    if (kind == 0 && x.loc == L_GGS && x.holdsGgsLoop) n++;
    if (kind == 1 && x.loc == L_TAE) n++;
    if (kind == 2 && x.loc == L_CD && x.phase != P_UNLOAD) n++;
    if (kind == 3 && x.loc == L_DEPOT) n++;
}
return n;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000460</Id>
<Name><![CDATA[rakeX]]></Name>
<Description><![CDATA[Animation: x of rake i.]]></Description>
<X>2920</X><Y>580</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[i]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[Rake r = rakeAt(i);
if (r == null) return -1000;
switch (r.phase) {
    case P_SPUR_L: return X_GGS + rakeProgress(r) * (X_TAE - X_GGS);
    case P_SPUR_E: return X_TAE - rakeProgress(r) * (X_TAE - X_GGS);
    case P_MAIN_L: return X_DN - 6;
    case P_MAIN_E: return X_UP - 6;
    case P_UNLOAD: return 1090 + r.tipplerNo * 52;
    default: break;
}
if (r.loc == L_GGS) return 150;
if (r.loc == L_TAE) return 880;
if (r.loc == L_DEPOT) return 1090 + (slotOf(r, 3) % 5) * 52;
return 1090 + (slotOf(r, 2) % 5) * 52;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000461</Id>
<Name><![CDATA[rakeY]]></Name>
<Description><![CDATA[Animation: y of rake i.]]></Description>
<X>2920</X><Y>606</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[i]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[Rake r = rakeAt(i);
if (r == null) return -1000;
switch (r.phase) {
    case P_SPUR_L: return Y_SPUR - 12;
    case P_SPUR_E: return Y_SPUR + 4;
    case P_MAIN_L: return Y_TAE + rakeProgress(r) * (Y_CD - Y_TAE);
    case P_MAIN_E: return Y_CD - rakeProgress(r) * (Y_CD - Y_TAE);
    case P_UNLOAD: return 706;
    default: break;
}
if (r.loc == L_GGS) {
    if (r.onSiding && r.sidingNo >= 0) return 404 + r.sidingNo * 28;
    return 284 + slotOf(r, 0) * 28;
}
if (r.loc == L_TAE) return 176 + slotOf(r, 1) * 22;
if (r.loc == L_DEPOT) return 866 + (slotOf(r, 3) / 5) * 22;
return 566 + (slotOf(r, 2) / 5) * 22;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[boolean]]></ReturnType>
<Id>1791000000462</Id>
<Name><![CDATA[rakeVertical]]></Name>
<Description><![CDATA[Rakes on the main line are drawn upright.]]></Description>
<X>2920</X><Y>632</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[i]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[Rake r = rakeAt(i);
return r != null && (r.phase == P_MAIN_L || r.phase == P_MAIN_E);]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
<Id>1791000000463</Id>
<Name><![CDATA[rakeColor]]></Name>
<Description><![CDATA[Loaded = coal black, empty = wagon brown, crew relief = red, BPC = orange.]]></Description>
<X>2920</X><Y>658</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[i]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[Rake r = rakeAt(i);
if (r == null) return java.awt.Color.LIGHT_GRAY;
if (r.phase == P_WAIT_RELIEF) return new java.awt.Color(200, 40, 40);
if (r.phase == P_BPC) return new java.awt.Color(240, 150, 30);
return r.loaded ? new java.awt.Color(40, 40, 40) : new java.awt.Color(176, 128, 80);]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1791000000464</Id>
<Name><![CDATA[rakeLabel]]></Name>
<Description><![CDATA[Short label: rake number and phase code.]]></Description>
<X>2920</X><Y>684</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[i]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[Rake r = rakeAt(i);
if (r == null) return "";
return "R" + r.id;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000465</Id>
<Name><![CDATA[paxY]]></Name>
<Description><![CDATA[Animation: y of the k-th passenger/goods train currently near the TAE-CD stretch (or -1000).]]></Description>
<X>2920</X><Y>710</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[k]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[dn]]></Name>
<Type><![CDATA[boolean]]></Type>
</Parameter>
<Body><![CDATA[java.util.ArrayList<Blocker> list = dn ? dnBlock : upBlock;
int n = 0;
for (Blocker b : list) {
    if (b.kind == B_OWN) continue;
    double age = time() - b.t;     // hours since passing TAE (DN) / leaving CD (UP)
    if (age < -0.12 || age > 0.17) continue;
    if (n++ == k) return dn ? Y_TAE + age * 2000 : Y_CD - age * 2000;
}
return -1000;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[java.awt.Color]]></ReturnType>
<Id>1791000000466</Id>
<Name><![CDATA[paxColor]]></Name>
<Description><![CDATA[Passenger trains blue, through goods grey.]]></Description>
<X>2920</X><Y>736</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[k]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[dn]]></Name>
<Type><![CDATA[boolean]]></Type>
</Parameter>
<Body><![CDATA[java.util.ArrayList<Blocker> list = dn ? dnBlock : upBlock;
int n = 0;
for (Blocker b : list) {
    if (b.kind == B_OWN) continue;
    double age = time() - b.t;
    if (age < -0.12 || age > 0.17) continue;
    if (n++ == k) return b.kind == B_PAX ? new java.awt.Color(30, 90, 200) : java.awt.Color.GRAY;
}
return java.awt.Color.GRAY;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1791000000467</Id>
<Name><![CDATA[resourceText]]></Name>
<Description><![CDATA[Live occupancy of the constrained resources.]]></Description>
<X>2920</X><Y>762</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[return String.format("GGS loops %d/%d   sidings %d/%d   single line %s%s   TAE loops %d/%d   tipplers %d/%d   crews free %d/%d   exam line %s",
    ggsLoopUsed, cGgsLoops, sidingsBusy, cSidings,
    lineBusyDN ? "DN busy" : (lineBusyUP && !cDoubled ? "UP busy" : "free"), cDoubled ? (lineBusyUP ? " / UP busy" : " / UP free") : "",
    taeLoopLoaded + taeLoopEmpty, cTaeLoops, tipplersBusy, cTipplers, freeCrews(), cCrewPool, examBusy ? "busy" : "free");]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
