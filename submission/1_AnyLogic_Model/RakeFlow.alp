    for (String k : KPI) sb.append(String.format("  %18s", k));
    sb.append("\n");
    for (java.util.Map.Entry<Integer, java.util.ArrayList<double[]>> e : byKey.entrySet()) {
        java.util.ArrayList<double[]> rows = e.getValue();
