<Id>1791000000452</Id>
<Name><![CDATA[deliveredLast24h]]></Name>
<Description><![CDATA[Rolling count of rakes placed at CSTPS in the last 24 h (time plot).]]></Description>
<X>2920</X><Y>372</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[int n = 0;
for (int i = deliveryTimes.size() - 1; i >= 0 && deliveryTimes.get(i) > time() - 24; i--) n++;
return n;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1791000000453</Id>
<Name><![CDATA[kpiText]]></Name>
<Description><![CDATA[The KPI panel on the Main view.]]></Description>
<X>2920</X><Y>398</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[String s = String.format(java.util.Locale.US,
    "Day %.1f   %s   (stats from day %.0f)\n\n" +
    "Rakes placed at CSTPS   %d   =  %.2f rakes/day   (%.1f kt/day)\n" +
    "Mean cycle time         %.1f h   (P90 %.1f h)   over %d cycles\n" +
    "Single line busy        %.0f %%     Sidings busy %.0f %%     Tipplers busy %.0f %%\n" +
    "Mean wait for DN path   %.2f h at Tadali   (queue avg %.2f, max %d)\n" +
    "Demurrage               Rs %.0f per rake  (loading %d/%d over FT, unloading %d/%d)\n" +
    "Crew relief cycles      %.0f %%   duty extensions %d   expiries per 100 trips %.1f\n" +
    "BPC detour cycles       %.0f %%   overdue exams %d   exam h/rake/month %.1f\n" +
    "CSTPS stock             %.1f days  (min %.1f, days below 7: %d)",
    time() / 24, stampText(time()), statsStart / 24,
    delivered, rakesPerDay(), rakesPerDay() * payload_t / 1000,
    meanCycle(), p90Cycle(), cyclesDone,
    100 * lineUtil(), 100 * sidingUtil(), 100 * tipplerUtil(),
    mergeCount == 0 ? 0 : mergeWaitSum / mergeCount, mergeQueueAvg(), maxMergeQ,
    demurragePerRake(), loadOverFree, loadEnds, unloadOverFree, unloadEnds,
    100 * shareRelief(), extensions, crewExpiriesPer100(),
    100 * shareBpc(), bpcOverdue, examHoursPerRakeMonth(),
    stockDays(), stockMinDays == Double.POSITIVE_INFINITY ? stockDays() : stockMinDays, daysBelow7);
return s;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1791000000454</Id>
<Name><![CDATA[decompText]]></Name>
<Description><![CDATA[Cycle-time decomposition table (KPI 1).]]></Description>
<X>2920</X><Y>424</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[StringBuilder sb = new StringBuilder("Where a rake loses time (mean h per cycle)\n");
for (int k = 0; k < NPH; k++)
    sb.append(String.format(java.util.Locale.US, "%-30s %6.2f\n", PH_NAME[k], compMean(k)));
sb.append(String.format(java.util.Locale.US, "%-30s %6.2f", "TOTAL cycle", meanCycle()));
return sb.toString();]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1791000000455</Id>
<Name><![CDATA[nextTrainsText]]></Name>
<Description><![CDATA[Next DN passings at Tadali and UP departures from Chandrapur (passenger + goods + own rakes).]]></Description>
<X>2920</X><Y>450</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[StringBuilder sb = new StringBuilder("Next DN at Tadali            Next UP at Chandrapur\n");
java.util.ArrayList<String> a = new java.util.ArrayList<String>(), b = new java.util.ArrayList<String>();
for (Blocker x : dnBlock) if (x.t >= time() && a.size() < 6) a.add(blockerText(x));
for (Blocker x : upBlock) if (x.t >= time() && b.size() < 6) b.add(blockerText(x));
for (int i = 0; i < 6; i++)
    sb.append(String.format("%-29s%s\n", i < a.size() ? a.get(i) : "", i < b.size() ? b.get(i) : ""));
return sb.toString();]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
