<StartupCode><![CDATA[// Build the timetable, rakes and crews and start the kernel clock (see function initModel).
initModel();]]></StartupCode>
<DestroyCode><![CDATA[// Append this run's KPIs to RakeFlow_runs.csv and write the per-cycle log.
writeResults();]]></DestroyCode>
