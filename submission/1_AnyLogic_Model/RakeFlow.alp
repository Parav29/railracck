<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000436</Id>
<Name><![CDATA[p90Cycle]]></Name>
<Description><![CDATA[KPI 1: 90th percentile of rake cycle time (h).]]></Description>
<X>2660</X><Y>684</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[if (cycleTimes.isEmpty()) return 0;
java.util.ArrayList<Double> v = new java.util.ArrayList<Double>(cycleTimes);
java.util.Collections.sort(v);
return v.get(Math.min(v.size() - 1, (int) Math.ceil(0.9 * v.size()) - 1));]]></Body>
</Function>
