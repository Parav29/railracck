<Functions>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000384</Id>
<Name><![CDATA[schedAt]]></Name>
<Description><![CDATA[Kernel: put a job on the future-event list at absolute model time t (hours).]]></Description>
<X>2400</X><Y>60</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[t]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[job]]></Name>
<Type><![CDATA[Runnable]]></Type>
</Parameter>
<Body><![CDATA[Ev e = new Ev();
e.t = Math.max(t, time());
e.seq = evSeq++;
e.job = job;
fel.add(e);
if (!inRun) armClock();]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000385</Id>
<Name><![CDATA[schedAfter]]></Name>
<Description><![CDATA[Kernel: run a job dt hours from now.]]></Description>
<X>2400</X><Y>86</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[dt]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[job]]></Name>
<Type><![CDATA[Runnable]]></Type>
</Parameter>
<Body><![CDATA[schedAt(time() + Math.max(0, dt), job);]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000386</Id>
<Name><![CDATA[armClock]]></Name>
<Description><![CDATA[Kernel: make sure exactly one AnyLogic DynamicEvent is armed at the earliest kernel event.]]></Description>
<X>2400</X><Y>112</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[Ev e = fel.peek();
if (e == null) return;
if (wake != null && wakeAt <= e.t) return;
if (wake != null) wake.reset();
wakeAt = e.t;
wake = new DynamicEvent(this, Math.max(0, e.t - time()), TimeUnits.HOUR) {
    @Override
    public void execute() {
        wake = null;
        wakeAt = Double.POSITIVE_INFINITY;
        runDue();
    }
};]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000387</Id>
<Name><![CDATA[runDue]]></Name>
<Description><![CDATA[Kernel: execute every kernel job that is due now (ties in scheduling order), then re-arm the clock.]]></Description>
<X>2400</X><Y>138</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[inRun = true;
while (!fel.isEmpty() && fel.peek().t <= time() + 1e-9) {
    Ev e = fel.poll();
    touchStats();
    e.job.run();
}
inRun = false;
armClock();]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000388</Id>
<Name><![CDATA[rUnif]]></Name>
<Description><![CDATA[Uniform(a,b) from the model's own stream (seeded by parameter seed).]]></Description>
<X>2400</X><Y>164</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[a]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[b]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[return a + (b - a) * rng.nextDouble();]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000389</Id>
<Name><![CDATA[rTri]]></Name>
<Description><![CDATA[Triangular(min, mode, max) by inverse CDF. NOTE argument order is min, MODE, max as in the brief.]]></Description>
<X>2400</X><Y>190</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[min]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[mode]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[max]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[if (max <= min) return min;
double u = rng.nextDouble();
double f = (mode - min) / (max - min);
if (u < f) return min + Math.sqrt(u * (max - min) * (mode - min));
return max - Math.sqrt((1 - u) * (max - min) * (max - mode));]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000390</Id>
<Name><![CDATA[rLogn]]></Name>
<Description><![CDATA[Lognormal with the given mean and standard deviation (A-21 passenger lateness).]]></Description>
<X>2400</X><Y>216</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[mean]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[sd]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[if (mean <= 0) return 0;
double s2 = Math.log(1 + (sd * sd) / (mean * mean));
double mu = Math.log(mean) - s2 / 2;
return Math.exp(mu + Math.sqrt(s2) * rng.nextGaussian());]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[int]]></ReturnType>
<Id>1791000000391</Id>
<Name><![CDATA[rPois]]></Name>
<Description><![CDATA[Poisson count (through goods trains per day, A-24).]]></Description>
<X>2400</X><Y>242</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[lambda]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[if (lambda <= 0) return 0;
double L = Math.exp(-lambda), p = 1;
int k = 0;
do { k++; p *= rng.nextDouble(); } while (p > L);
return k - 1;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000392</Id>
<Name><![CDATA[setPhase]]></Name>
<Description><![CDATA[Close the current cycle-time component of rake r and open component p (endExpected used by the animation).]]></Description>
<X>2400</X><Y>268</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[p]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[endExpected]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[double t = time();
if (r.phase >= 0) r.comp[r.phase] += t - r.phaseStart;
r.phase = p;
r.phaseStart = t;
r.phaseEnd = endExpected;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000393</Id>
<Name><![CDATA[initModel]]></Name>
<Description><![CDATA[Start-up: read parameters (and scenario overrides), build timetable blockers, create rakes and crews.]]></Description>
<X>2400</X><Y>294</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[rng = new java.util.Random(seed);
cFleet = fleetSize; cSidings = loadingSidings; cGgsLoops = ghugusLoops_A01; cTaeLoops = tadaliLoops_A02;
cTipplers = tipplersInService_A17; cCrewPool = crewPoolSize_A25; cPolicy = pathPolicy; cPhase = modelPhase;
cDoubled = lineDoubled_INF04; cRls = loadingByRLS_LD04; cLocalLobby = crewAtChandrapur_A06;
cAllowExt = allowDutyExtension_CR02; cAbsBlock = absoluteBlockTAE_CD_A23; cThroughPerDay = throughGoodsPerDay_A24;
cDispatch = dispatchPolicy_A28; cBatch = Math.max(1, batchSize_A28); cCrewAtLoad = crewOrderedAtLoading_A29;
cBpcLook = bpcLookaheadDays;
applyScenario(scenario);
cCrewOn = cPhase >= 2;
cBpcOn = cPhase >= 3;
cTaeLoops = Math.max(2, cTaeLoops);   // one TAE loop is always kept for loaded rakes (deadlock rule)
cSidings = Math.max(1, Math.min(16, cSidings));
cTipplers = Math.max(1, Math.min(16, cTipplers));
for (int d = -1; d <= 2; d++) genDay(d);
lastGeneratedDay = 2;
for (int i = 0; i < cCrewPool; i++) { Crew c = new Crew(); c.id = i + 1; crews.add(c); }
stockKt = initialStock_kt;
for (int i = 0; i < cFleet; i++) {
    Rake r = new Rake();
    r.id = i + 1;
    r.loaded = false;
    r.loc = L_CD;
    r.bpcKm = rUnif(1500, bpcKm_BPC01);
    r.bpcDue = rUnif(1, bpcDays_BPC01) * 24;
    rakes.add(r);
    setPhase(r, P_RELEASE_CD, -1);
    // rakes start as released empties at CSTPS, staggered so they do not all start together
    schedAfter(i * 2.5, () -> releasedAtCD(r));
}
for (int d = 1; d <= 400; d++) {
    final int day = d;
    schedAt(day * 24.0, () -> dailyTick(day));
}
schedAt(warmupDays * 24.0, () -> resetStats());
// results are written at the end of the horizon (and, if the run is stopped early, on destroy)
schedAt((warmupDays + runDays) * 24.0 - 1e-6, () -> writeResults());]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000394</Id>
<Name><![CDATA[applyScenario]]></Name>
<Description><![CDATA[Experiment presets E2-E7 (scenario 0 = use the parameter values as set).]]></Description>
<X>2400</X><Y>320</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[s]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[switch (s) {
    case 1: cRls = true; break;                          // E2 RLS / silo loading
    case 2: cPolicy = 1; break;                          // E3 planned DN slot, crew ordered to match
    case 3: cPolicy = 2; break;                          // E3 priority to crews with < 2 h left
    case 4: cLocalLobby = true; break;                   // E4 crew booked at Chandrapur
    case 5: cDoubled = true; break;                      // E5 Ghugus-Tadali doubling
    case 6: cTipplers = 3; break;                        // E6
    case 7: cTipplers = 5; break;                        // E6
    case 8: cGgsLoops += 1; cTaeLoops += 1; break;       // E7 loops +20% (rounded up to +1)
    case 9: cCrewPool = (int) Math.ceil(cCrewPool * 1.2); break;   // E7 crew +20%
    case 10: cSidings += 1; break;                       // E7 loading sidings +1
    case 11: cThroughPerDay = 0; break;                  // sensitivity: no through goods on main line
    case 12: cDispatch = 1; break;                       // dispatch: alternate directions on the single line
    case 13: cDispatch = 2; break;                       // dispatch: batches of batchSize_A28 moves per direction
    case 14: cCrewAtLoad = true; break;                  // crew ordered during loading (A-29)
    case 15: cBpcLook = 3; break;                        // exam trigger: 3 days of validity left
    case 16: cBpcLook = 5; break;                        // exam trigger: 5 days left
    case 17: cBpcLook = 7; break;                        // exam trigger: 7 days left
    case 18: cBpcLook = 0; break;                        // exam trigger: at expiry
    // ---- key experiments for the final presentation (19-27): same settings as model/harness/key_experiments.py ----
    case 19: break;                                                  // baseline (same as 0)
    case 20: cCrewAtLoad = true; break;                              // Exp 1 crew ordered during loading
    case 21: cGgsLoops = 3; break;                                   // Exp 2 third loop at Ghugus
    case 22: cRls = true; break;                                     // Exp 3 rapid loading silo
    case 23: cDoubled = true; break;                                 // Exp 4 line doubling
    case 24: cCrewAtLoad = true; cGgsLoops = 3; cRls = true; break;  // all three
    case 25: cCrewAtLoad = true; cGgsLoops = 3; break;               // crew + loop
    case 26: cCrewAtLoad = true; cRls = true; break;                 // crew + silo
    case 27: cGgsLoops = 3; cRls = true; break;                      // loop + silo
    default: break;
}]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000395</Id>
<Name><![CDATA[genDay]]></Name>
<Description><![CDATA[Build the blockers for day d: scheduled passenger trains on their days of run + lognormal lateness (A-21) + through goods trains (A-24).]]></Description>
<X>2400</X><Y>346</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[d]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[int dow = ((d % 7) + 7) % 7;   // 0 = Monday
for (String row : TIMETABLE) {
    String[] f = row.split(",");
    boolean dn = f[0].equals("DN");
    if (f[2].charAt(dow) != '1') continue;
    double late = rLogn(latenessMean_A21, latenessSd_A21) / 60.0;
    double t = d * 24.0 + Integer.parseInt(f[1]) / 60.0 + late;
    insertBlocker(dn ? dnBlock : upBlock, new Blocker(t, B_PAX, f[3]));
}
for (int k = 0; k < 2; k++) {
    int n = rPois(cThroughPerDay);
    for (int j = 0; j < n; j++)
        insertBlocker(k == 0 ? dnBlock : upBlock, new Blocker(d * 24.0 + rUnif(0, 24), B_GOODS, "goods"));
}]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000396</Id>
<Name><![CDATA[insertBlocker]]></Name>
<Description><![CDATA[Insert keeping the list sorted by passing time.]]></Description>
<X>2400</X><Y>372</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[list]]></Name>
<Type><![CDATA[java.util.ArrayList<Blocker>]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[b]]></Name>
<Type><![CDATA[Blocker]]></Type>
</Parameter>
<Body><![CDATA[int lo = 0, hi = list.size();
while (lo < hi) { int m = (lo + hi) >>> 1; if (list.get(m).t <= b.t) lo = m + 1; else hi = m; }
list.add(lo, b);]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000397</Id>
<Name><![CDATA[nextGap]]></Name>
<Description><![CDATA[Earliest t >= t0 with no train passing in (t - gLead, t + gTrail). gTrail adds the catch-up margin for a following passenger train when A-23 absolute block is on.]]></Description>
<X>2400</X><Y>398</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[list]]></Name>
<Type><![CDATA[java.util.ArrayList<Blocker>]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[t0]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[gLead]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[run]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[double t = t0;
double paxRun = mainKm_INF08 / 80.0;
double maxTrail = gLead + (cAbsBlock ? Math.max(0, run - paxRun) : 0);
int lo = 0, hi = list.size();
while (lo < hi) { int m = (lo + hi) >>> 1; if (list.get(m).t <= t - gLead) lo = m + 1; else hi = m; }
for (int i = lo; i < list.size(); i++) {
    Blocker b = list.get(i);
    if (b.t >= t + maxTrail) break;
    double trail = gLead + ((cAbsBlock && b.kind == B_PAX) ? Math.max(0, run - paxRun) : 0);
    if (b.t > t - gLead && b.t < t + trail) t = b.t + gLead;
}
return t;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000398</Id>
<Name><![CDATA[dailyTick]]></Name>
<Description><![CDATA[00:00 every day: extend the timetable two days ahead, drop old blockers, update CSTPS coal stock.]]></Description>
<X>2400</X><Y>424</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[day]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[while (lastGeneratedDay < day + 2) { lastGeneratedDay++; genDay(lastGeneratedDay); }
double cut = time() - 12;
while (!dnBlock.isEmpty() && dnBlock.get(0).t < cut) dnBlock.remove(0);
while (!upBlock.isEmpty() && upBlock.get(0).t < cut) upBlock.remove(0);
double burn = rTri(consumptionMin_kt, consumptionMode_kt, consumptionMax_kt);
stockKt += nonRailSupply_kt - burn;
if (time() >= statsStart && time() >= warmupDays * 24.0) {
    double days = stockKt / normativeDaily_kt;
    stockMinDays = Math.min(stockMinDays, days);
    if (days < 7) daysBelow7++;
}]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000399</Id>
<Name><![CDATA[dispatch]]></Name>
<Description><![CDATA[The section controller: keep allocating sidings, crews, the single line, CD departures, tipplers and the exam line until nothing more can move.]]></Description>
<X>2400</X><Y>450</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[if (inDispatch) { dispatchAgain = true; return; }
inDispatch = true;
do {
    dispatchAgain = false;
    boolean p = true;
    while (p) {
        p = false;
        if (drawOutBlocked()) p = true;
        if (startLoading()) p = true;
        if (assignCrew()) p = true;
        if (allocLine()) p = true;
        if (departCD()) p = true;
        if (startTippler()) p = true;
        if (startExam()) p = true;
    }
} while (dispatchAgain);
inDispatch = false;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000400</Id>
<Name><![CDATA[arriveGGS]]></Name>
<Description><![CDATA[Empty rake arrives at Ghugus (it already holds a GGS loop). Closes the previous cycle and starts a new one.]]></Description>
<X>2400</X><Y>476</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[if (r.cycleStart >= 0) closeCycle(r);
r.cycleStart = time();
r.cycleNo++;
java.util.Arrays.fill(r.comp, 0);
java.util.Arrays.fill(r.stamp, -1);
r.stamp[S_ARR_GGS] = time();
r.bpcThisCycle = false;
r.reliefThisCycle = false;
r.crewPreOrdered = false; r.crewOnBoardEarly = false; r.readyDone = false; r.readyDur = -1;
r.loaded = false;
r.loc = L_GGS;
setPhase(r, P_PLACE_GGS, -1);
schedAfter(rTri(placeLoadMin_A13, placeLoadMode_A13, placeLoadMax_A13), () -> {
    setPhase(r, P_WAIT_SIDING, -1);
    qSiding.add(r);
    dispatch();
});]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[boolean]]></ReturnType>
<Id>1791000000401</Id>
<Name><![CDATA[startLoading]]></Name>
<Description><![CDATA[Place the first waiting empty on a free loading siding (CHP) and start loading.]]></Description>
<X>2400</X><Y>502</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[if (qSiding.isEmpty() || sidingsBusy >= cSidings) return false;
Rake r = qSiding.remove(0);
int k = 0;
while (sidingUsed[k]) k++;
sidingUsed[k] = true;
sidingsBusy++;
r.sidingNo = k;
r.onSiding = true;
if (r.holdsGgsLoop) { r.holdsGgsLoop = false; ggsLoopUsed--; }
r.placedAt = time();
r.stamp[S_PLACED] = time();
r.stamp[S_LOAD_START] = time();
double lt = cRls ? rTri(loadRlsMin_LD04, loadRlsMode_LD04, loadRlsMax_LD04)
                 : rTri(loadMin_LD03, loadMode_LD03, loadMax_LD03);
setPhase(r, P_LOAD, time() + lt);
schedAfter(lt, () -> loadDone(r));
if (cCrewAtLoad && cCrewOn && cPolicy != 1) {
    // A-29: draw the release->ready time now and order the crew so it should arrive just as the rake is ready
    r.readyDur = rTri(readyMin_A14, readyMode_A14, readyMax_A14);
    double orderAt = time() + lt + r.readyDur - expectedCrewLead(true);
    schedAt(Math.max(time(), orderAt), () -> preOrderCrew(r));
}
return true;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000402</Id>
<Name><![CDATA[loadDone]]></Name>
<Description><![CDATA[Loading finished = release. Demurrage on placement->release over FT-01. Rake is drawn out to a GGS loop if one is free, else it is prepared on the siding (blocking it).]]></Description>
<X>2400</X><Y>528</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[r.loaded = true;
r.stamp[S_LOAD_END] = time();
r.stamp[S_RELEASED] = time();
chargeDemurrage(time() - r.placedAt, freeTimeLoad_FT01, true);
if (ggsLoopUsed < cGgsLoops) { ggsLoopUsed++; r.holdsGgsLoop = true; releaseSiding(r); }
setPhase(r, P_READY_GGS, -1);
double rd = r.readyDur >= 0 ? r.readyDur : rTri(readyMin_A14, readyMode_A14, readyMax_A14);
schedAfter(rd, () -> readyGGS(r));
dispatch();]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000403</Id>
<Name><![CDATA[releaseSiding]]></Name>
<Description><![CDATA[Free the loading siding held by rake r.]]></Description>
<X>2400</X><Y>554</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[if (r.sidingNo >= 0) { sidingUsed[r.sidingNo] = false; sidingsBusy--; }
r.sidingNo = -1;
r.onSiding = false;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[boolean]]></ReturnType>
<Id>1791000000404</Id>
<Name><![CDATA[drawOutBlocked]]></Name>
<Description><![CDATA[A loaded rake still standing on a siding is drawn out to a GGS loop as soon as one frees, so the siding can take the next empty.]]></Description>
<X>2400</X><Y>580</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[if (ggsLoopUsed >= cGgsLoops) return false;
for (Rake r : rakes) {
    if (r.loaded && r.onSiding && r.loc == L_GGS && r.phase != P_LOAD) {
        ggsLoopUsed++;
        r.holdsGgsLoop = true;
        releaseSiding(r);
        return true;
    }
}
return false;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000405</Id>
<Name><![CDATA[readyGGS]]></Name>
<Description><![CDATA[Loaded rake ready to leave Ghugus (A-14 done): ask for a crew. Policy 1 first plans the DN path at Tadali and orders the crew to match it.]]></Description>
<X>2400</X><Y>606</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[r.stamp[S_LOCO] = time();
r.readyDone = true;
if (r.crewPreOrdered) {
    // A-29: crew was ordered during loading; go if it is already on the train, else wait for it
    if (r.crewOnBoardEarly) { setPhase(r, P_WAIT_PATH_GGS, -1); qDepartGGS.add(r); dispatch(); }
    else setPhase(r, P_WAIT_CREW_L, -1);
    return;
}
if (cPolicy == 1 && cCrewOn) {
    double lead = expectedCrewLead(true);
    double spur = spurOccMode_A04 / 60.0;
    double run = mainKm_INF08 / mainSpeedMode_A03;
    double slot = nextGap(dnBlock, time() + lead + spur, mergeGapMode_A05 / 60.0, run);
    double orderAt = Math.max(time(), slot - spur - 0.25 - lead);
    setPhase(r, P_WAIT_PATH_GGS, -1);
    schedAt(orderAt, () -> requestCrew(r));
} else {
    requestCrew(r);
}]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000406</Id>
<Name><![CDATA[expectedCrewLead]]></Name>
<Description><![CDATA[Mean sign-on + travel time of a crew from the booking lobby to the train.]]></Description>
<X>2400</X><Y>632</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[toGhugus]]></Name>
<Type><![CDATA[boolean]]></Type>
</Parameter>
<Body><![CDATA[double signOn = (signOnMin_A08 + signOnMode_A08 + signOnMax_A08) / 3.0;
if (toGhugus) return signOn + (cLocalLobby ? localLobbyTravel_A06 : (travelMin_A07 + travelMode_A07 + travelMax_A07) / 3.0);
return signOn + (cLocalLobby ? 0.25 : (travelCdMin_A26 + travelCdMode_A26 + travelCdMax_A26) / 3.0);]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000407</Id>
<Name><![CDATA[requestCrew]]></Name>
<Description><![CDATA[Queue rake r for a crew from the lobby pool (phase 1: crew always available, no clock).]]></Description>
<X>2400</X><Y>658</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[if (!cCrewOn) { crewReady(r); return; }
setPhase(r, r.loaded ? P_WAIT_CREW_L : P_WAIT_CREW_E, -1);
qCrew.add(r);
dispatch();]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[boolean]]></ReturnType>
<Id>1791000000408</Id>
<Name><![CDATA[assignCrew]]></Name>
<Description><![CDATA[Give the next waiting rake a free crew. Duty clock starts at sign-on in the lobby (CR-01..CR-05).]]></Description>
<X>2400</X><Y>684</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[if (qCrew.isEmpty()) return false;
Crew c = null;
for (Crew x : crews) if (!x.busy) { c = x; break; }
if (c == null) return false;
Rake r = qCrew.remove(0);
c.busy = true;
c.rake = r;
c.signOn = time();
c.extended = false;
c.dutyNo++;
r.crew = c;
if (r.stamp[S_CREW] < 0) r.stamp[S_CREW] = time();
double lead;
if (r.needRelief) lead = rTri(reliefMin_A09, reliefMode_A09, reliefMax_A09);
else {
    lead = rTri(signOnMin_A08, signOnMode_A08, signOnMax_A08);
    if (r.loaded) lead += cLocalLobby ? localLobbyTravel_A06 : rTri(travelMin_A07, travelMode_A07, travelMax_A07);
    else lead += cLocalLobby ? 0.25 : rTri(travelCdMin_A26, travelCdMode_A26, travelCdMax_A26);
}
final Crew cc = c;
final int duty = c.dutyNo;
// 2 h notice point (CR-02): if the crew is still on this trip, the controller gives notice -> limit becomes 11 h
schedAfter(dutyLimit_CR01 - noticeHours_CR02, () -> {
    if (cc.dutyNo == duty && cc.rake != null && cAllowExt && !cc.extended) { cc.extended = true; extensions++; }
});
schedAfter(dutyLimit_CR01, () -> expiryCheck(cc, duty));
schedAfter(extendedLimit_CR02, () -> expiryCheck(cc, duty));
crewTrips++;
schedAfter(lead, () -> crewReady(r));
return true;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000409</Id>
<Name><![CDATA[crewReady]]></Name>
<Description><![CDATA[Crew is on the train: resume according to where the rake stands.]]></Description>
<X>2400</X><Y>710</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[r.needRelief = false;
if (r.loc == L_GGS && r.crewPreOrdered && !r.readyDone) { r.crewOnBoardEarly = true; return; }   // A-29: crew waits on the train, duty clock running
if (r.loc == L_GGS) { setPhase(r, P_WAIT_PATH_GGS, -1); qDepartGGS.add(r); }
else if (r.loc == L_TAE && r.loaded) { planMerge(r); }
else if (r.loc == L_TAE) { setPhase(r, P_WAIT_LINE_TAE, -1); qLineTAE.add(r); }
else { planDepartCD(r); }
dispatch();]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000410</Id>
<Name><![CDATA[dutyLimitFor]]></Name>
<Description><![CDATA[Latest time crew c may still be working: 9 h, or 11 h if notice was / can still be given 2 h before expiry.]]></Description>
<X>2400</X><Y>736</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[c]]></Name>
<Type><![CDATA[Crew]]></Type>
</Parameter>
<Body><![CDATA[if (c == null) return Double.POSITIVE_INFINITY;
if (c.extended) return c.signOn + extendedLimit_CR02;
if (cAllowExt && time() <= c.signOn + dutyLimit_CR01 - noticeHours_CR02 + 1e-9) return c.signOn + extendedLimit_CR02;
return c.signOn + dutyLimit_CR01;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000411</Id>
<Name><![CDATA[expiryCheck]]></Name>
<Description><![CDATA[Duty limit reached while the train is standing: stable it and ask for relief (A-09).]]></Description>
<X>2400</X><Y>762</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[c]]></Name>
<Type><![CDATA[Crew]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[duty]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[if (c.dutyNo != duty || c.rake == null) return;
Rake r = c.rake;
if (r.phase == P_SPUR_L || r.phase == P_SPUR_E || r.phase == P_MAIN_L || r.phase == P_MAIN_E) return;
if (time() + 1e-9 >= dutyLimitFor(c)) relieve(r);]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000412</Id>
<Name><![CDATA[relieve]]></Name>
<Description><![CDATA[Crew signs off where the train stands; cancel its planned path; request a relief crew (A-09).]]></Description>
<X>2660</X><Y>60</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[Crew c = r.crew;
if (c == null) return;
signOff(c, r.loc);
r.crew = null;
r.token++;
reliefEvents++;
r.reliefThisCycle = true;
if (r.crewPreOrdered && !r.readyDone) {
    // A-29: an early crew ran out of duty before the rake was ready; order another without touching the rake's phase
    r.crewOnBoardEarly = false;
    qCrew.add(r);
    dispatch();
    return;
}
if (r.planned != null) { (r.loaded ? dnBlock : upBlock).remove(r.planned); r.planned = null; }
qDepartGGS.remove(r);
qLineTAE.remove(r);
qDepartCD.remove(r);
r.needRelief = true;
setPhase(r, P_WAIT_RELIEF, -1);
qCrew.add(r);
dispatch();]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000413</Id>
<Name><![CDATA[signOff]]></Name>
<Description><![CDATA[Crew signs off; returns to the Balharshah lobby and takes HQ rest (CR-04: 12 h after < 8 h duty, 16 h after >= 8 h).]]></Description>
<X>2660</X><Y>86</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[c]]></Name>
<Type><![CDATA[Crew]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[where]]></Name>
<Type><![CDATA[int]]></Type>
</Parameter>
<Body><![CDATA[double duty = time() - c.signOn;
dutySum += duty;
if (c.rake != null && c.rake.loaded && where == L_CD) c.rake.crewHoursLoaded = duty;
c.rake = null;
c.dutyNo++;
double back = where == L_GGS ? (cLocalLobby ? localLobbyTravel_A06 : rTri(travelMin_A07, travelMode_A07, travelMax_A07))
                             : (cLocalLobby ? 0.25 : rTri(travelCdMin_A26, travelCdMode_A26, travelCdMax_A26));
double rest = duty >= 8 ? hqRestLong_CR04 : hqRestShort_CR04;
final Crew cc = c;
schedAfter(back + rest, () -> { cc.busy = false; dispatch(); });]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[boolean]]></ReturnType>
<Id>1791000000414</Id>
<Name><![CDATA[allocLine]]></Name>
<Description><![CDATA[Single-line controller (A-22): loaded rakes from GGS first (needs a TAE loop), then empties from TAE (needs a GGS loop). Doubling (E5) gives each direction its own line.]]></Description>
<X>2660</X><Y>112</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[boolean canL = !lineBusyDN && !(!cDoubled && lineBusyUP) && !qDepartGGS.isEmpty() && taeLoopLoaded + taeLoopEmpty < cTaeLoops;
boolean canE = !lineBusyUP && !(!cDoubled && lineBusyDN) && !qLineTAE.isEmpty() && ggsLoopUsed < cGgsLoops;
// A-28 dispatch rule when both directions could go on a single line: 0 loaded first (A-22), 1 alternate, 2 batches
boolean preferE = false;
if (!cDoubled && canL && canE) {
    if (cDispatch == 1) preferE = lastDir == 0;
    else if (cDispatch == 2) preferE = lastDir == 0 ? batchN >= cBatch : (lastDir == 1 && batchN < cBatch);
}
// loaded GGS -> TAE
if (canL && !preferE) {
    Rake r = pickLoaded();
    boolean emptyFirst = false;
    if (cPolicy == 2 && !cDoubled && !qLineTAE.isEmpty() && ggsLoopUsed < cGgsLoops) {
        Rake e = qLineTAE.get(0);
        emptyFirst = crewLeft(e) < 2 && crewLeft(r) >= 2;
    }
    if (!emptyFirst) {
        double occ = rTri(spurOccMin_A04, spurOccMode_A04, spurOccMax_A04) / 60.0;
        if (cCrewOn && time() + occ > dutyLimitFor(r.crew)) { relieve(r); return true; }
        qDepartGGS.remove(r);
        noteDir(0);
        lineBusyDN = true;
        taeLoopLoaded++;
        r.holdsTaeLoop = true;
        if (r.onSiding) releaseSiding(r);
        if (r.holdsGgsLoop) { r.holdsGgsLoop = false; ggsLoopUsed--; }
        r.bpcKm -= spurKm_INF01;
        r.loc = L_SPUR;
        r.stamp[S_DEP_GGS] = time();
        setPhase(r, P_SPUR_L, time() + occ);
        schedAfter(occ, () -> {
            lineBusyDN = false;
            r.loc = L_TAE;
            r.stamp[S_ARR_TAE] = time();
            planMerge(r);
            dispatch();
        });
        return true;
    }
}
// empty TAE -> GGS
if (!lineBusyUP && !(!cDoubled && lineBusyDN) && !qLineTAE.isEmpty() && ggsLoopUsed < cGgsLoops) {
    Rake r = qLineTAE.get(0);
    double occ = rTri(spurOccMin_A04, spurOccMode_A04, spurOccMax_A04) / 60.0;
    if (cCrewOn && time() + occ > dutyLimitFor(r.crew)) { relieve(r); return true; }
    qLineTAE.remove(0);
    noteDir(1);
    lineBusyUP = true;
    ggsLoopUsed++;
    r.holdsGgsLoop = true;
    taeLoopEmpty--;
    r.holdsTaeLoop = false;
    r.bpcKm -= spurKm_INF01;
    r.loc = L_SPUR;
    setPhase(r, P_SPUR_E, time() + occ);
    schedAfter(occ, () -> {
        lineBusyUP = false;
        if (r.crew != null) signOff(r.crew, L_GGS);
        r.crew = null;
        arriveGGS(r);
        dispatch();
    });
    return true;
}
return false;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[Rake]]></ReturnType>
<Id>1791000000415</Id>
<Name><![CDATA[pickLoaded]]></Name>
<Description><![CDATA[Which loaded rake at GGS goes first: FCFS, or (policy 2) the one whose crew has least duty left.]]></Description>
<X>2660</X><Y>138</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[Rake best = qDepartGGS.get(0);
if (cPolicy == 2) for (Rake r : qDepartGGS) if (crewLeft(r) < crewLeft(best)) best = r;
return best;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000416</Id>
<Name><![CDATA[crewLeft]]></Name>
<Description><![CDATA[Hours of duty left for the crew on rake r.]]></Description>
<X>2660</X><Y>164</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[if (r == null || r.crew == null) return 99;
return dutyLimitFor(r.crew) - time();]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000417</Id>
<Name><![CDATA[planMerge]]></Name>
<Description><![CDATA[Loaded rake in a TAE loop: find the first DN path with gap A-05 either side of every passenger/goods train and reserve it.]]></Description>
<X>2660</X><Y>190</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[setPhase(r, P_WAIT_MERGE_DN, -1);
double run = mainKm_INF08 / rTri(mainSpeedMin_A03, mainSpeedMode_A03, mainSpeedMax_A03);
double g = rTri(mergeGapMin_A05, mergeGapMode_A05, mergeGapMax_A05) / 60.0;
double t = nextGap(dnBlock, time(), g, run);
// the crew cannot reach CSTPS inside its duty: relief is ordered now, the train waits in the loop
if (cCrewOn && t + run > dutyLimitFor(r.crew)) { relieve(r); return; }
Blocker b = new Blocker(t, B_OWN, "Rake " + r.id);
insertBlocker(dnBlock, b);
r.planned = b;
final int tok = r.token;
schedAt(t, () -> { if (r.token == tok) mergeDN(r, run); });]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000418</Id>
<Name><![CDATA[mergeDN]]></Name>
<Description><![CDATA[Rake leaves the TAE loop onto the DN main line and runs ~13 km to CD/CSTPS.]]></Description>
<X>2660</X><Y>216</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[run]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[r.planned = null;
taeLoopLoaded--;
r.holdsTaeLoop = false;
mergeWaitSum += time() - r.phaseStart;
mergeCount++;
r.bpcKm -= mainKm_INF08;
r.loc = L_MAIN;
r.stamp[S_DEP_TAE] = time();
setPhase(r, P_MAIN_L, time() + run);
schedAfter(run, () -> arriveCSTPS(r));
dispatch();]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000419</Id>
<Name><![CDATA[arriveCSTPS]]></Name>
<Description><![CDATA[Loaded rake reaches CSTPS: crew signs off, railway places the rake (A-15); free time FT-02 runs from placement.]]></Description>
<X>2660</X><Y>242</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[r.loc = L_CD;
r.stamp[S_ARR_CD] = time();
if (r.crew != null) signOff(r.crew, L_CD);
r.crew = null;
setPhase(r, P_PLACE_CD, -1);
schedAfter(rTri(placeUnloadMin_A15, placeUnloadMode_A15, placeUnloadMax_A15), () -> {
    r.placedAt = time();
    r.stamp[S_PLACED_TIP] = time();
    if (time() >= statsStart) { delivered++; tonnes += payload_t; deliveryTimes.add(time()); }
    setPhase(r, P_WAIT_TIPPLER, -1);
    qTippler.add(r);
    dispatch();
});]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[boolean]]></ReturnType>
<Id>1791000000420</Id>
<Name><![CDATA[startTippler]]></Name>
<Description><![CDATA[Next placed rake goes to a free tippler (A-17 in service).]]></Description>
<X>2660</X><Y>268</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[if (qTippler.isEmpty() || tipplersBusy >= cTipplers) return false;
Rake r = qTippler.remove(0);
int k = 0;
while (tipplerUsed[k]) k++;
tipplerUsed[k] = true;
tipplersBusy++;
r.tipplerNo = k;
r.stamp[S_UNLOAD_START] = time();
double ut = rTri(unloadMin_UL02, unloadMode_UL02, unloadMax_UL02);
setPhase(r, P_UNLOAD, time() + ut);
schedAfter(ut, () -> unloadDone(r));
return true;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000421</Id>
<Name><![CDATA[unloadDone]]></Name>
<Description><![CDATA[Tippling finished: coal into CSTPS stock, demurrage on placement->release over FT-02, then A-16 release->despatch.]]></Description>
<X>2660</X><Y>294</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[tipplerUsed[r.tipplerNo] = false;
tipplersBusy--;
r.tipplerNo = -1;
r.loaded = false;
stockKt += payload_t / 1000.0;
r.stamp[S_UNLOAD_END] = time();
r.stamp[S_REL_EMPTY] = time();
chargeDemurrage(time() - r.placedAt, freeTimeUnload_FT02, false);
setPhase(r, P_RELEASE_CD, -1);
schedAfter(rTri(releaseMin_A16, releaseMode_A16, releaseMax_A16), () -> releasedAtCD(r));
dispatch();]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000422</Id>
<Name><![CDATA[releasedAtCD]]></Name>
<Description><![CDATA[Empty ready at CSTPS: divert to the BPC exam if due (phase 3), otherwise ask for a crew.]]></Description>
<X>2660</X><Y>320</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[r.loc = L_CD;
r.loaded = false;
if (cBpcOn && (time() >= r.bpcDue - cBpcLook * 24 || r.bpcKm < 2 * (spurKm_INF01 + mainKm_INF08) + 2 * depotKm_A10)) {
    goBpc(r);
    return;
}
setPhase(r, P_WAIT_PATH_CD, -1);
qDepartCD.add(r);
dispatch();]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[boolean]]></ReturnType>
<Id>1791000000423</Id>
<Name><![CDATA[departCD]]></Name>
<Description><![CDATA[Controller orders the next empty out of CSTPS only when a TAE loop (not the one kept for loaded rakes) is free and, if A-27, Ghugus has a free loop; then the crew is booked.]]></Description>
<X>2660</X><Y>346</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[if (qDepartCD.isEmpty()) return false;
if (taeLoopLoaded + taeLoopEmpty >= cTaeLoops || taeLoopEmpty >= cTaeLoops - 1) return false;
if (controllerHoldsEmptiesAtCD_A27 && ggsLoopUsed >= cGgsLoops) return false;
Rake r = qDepartCD.remove(0);
taeLoopEmpty++;
r.taeLoopReserved = true;
requestCrew(r);
return true;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000424</Id>
<Name><![CDATA[planDepartCD]]></Name>
<Description><![CDATA[Empty at CD with crew and a reserved TAE loop: take the first UP path with gap A-05 and run to Tadali.]]></Description>
<X>2660</X><Y>372</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[setPhase(r, P_WAIT_PATH_CD, -1);
double run = mainKm_INF08 / rTri(mainSpeedMin_A03, mainSpeedMode_A03, mainSpeedMax_A03);
double g = rTri(mergeGapMin_A05, mergeGapMode_A05, mergeGapMax_A05) / 60.0;
double t = nextGap(upBlock, time(), g, run);
if (cCrewOn && t + run > dutyLimitFor(r.crew)) { relieve(r); return; }
Blocker b = new Blocker(t, B_OWN, "Rake " + r.id);
insertBlocker(upBlock, b);
r.planned = b;
final int tok = r.token;
schedAt(t, () -> {
    if (r.token != tok) return;
    r.planned = null;
    r.taeLoopReserved = false;
    r.holdsTaeLoop = true;
    r.bpcKm -= mainKm_INF08;
    r.loc = L_MAIN;
    r.stamp[S_DEP_CD] = time();
    setPhase(r, P_MAIN_E, time() + run);
    schedAfter(run, () -> {
        r.loc = L_TAE;
        setPhase(r, P_WAIT_LINE_TAE, -1);
        qLineTAE.add(r);
        dispatch();
    });
});]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000425</Id>
<Name><![CDATA[goBpc]]></Name>
<Description><![CDATA[BPC detour (phase 3): empty runs CD -> Balharshah depot (A-10), waits for placement (A-11), then the 8 h intensive exam (A-12) in daylight only.]]></Description>
<X>2660</X><Y>398</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[r.bpcThisCycle = true;
if (time() >= statsStart) bpcDetours++;
r.loc = L_DEPOT;
setPhase(r, P_BPC, -1);
r.bpcKm -= depotKm_A10;
double travel = depotKm_A10 / rTri(mainSpeedMin_A03, mainSpeedMode_A03, mainSpeedMax_A03) + depotPathWait_A10;
schedAfter(travel + rTri(examWaitMin_A11, examWaitMode_A11, examWaitMax_A11), () -> { qExam.add(r); dispatch(); });]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[boolean]]></ReturnType>
<Id>1791000000426</Id>
<Name><![CDATA[startExam]]></Name>
<Description><![CDATA[One examination line at the depot (capacity 1).]]></Description>
<X>2660</X><Y>424</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[if (examBusy || qExam.isEmpty()) return false;
Rake r = qExam.remove(0);
examBusy = true;
if (time() > r.bpcDue + bpcGraceDays * 24 && time() >= statsStart) bpcOverdue++;
examWork(r, rTri(examMin_A12, examMode_A12, examMax_A12));
return true;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000427</Id>
<Name><![CDATA[examWork]]></Name>
<Description><![CDATA[Exam work only progresses between examOpenHour and examCloseHour (BPC-03 daylight window).]]></Description>
<X>2660</X><Y>450</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[remaining]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[double h = time() % 24;
if (h < examOpenHour - 1e-6) { schedAfter(examOpenHour - h, () -> examWork(r, remaining)); return; }
if (h >= examCloseHour - 1e-6) { schedAfter(24 - h + examOpenHour, () -> examWork(r, remaining)); return; }
double can = examCloseHour - h;
if (remaining <= can) {
    schedAfter(remaining, () -> {
        examBusy = false;
        r.bpcKm = bpcKm_BPC01;
        r.bpcDue = time() + bpcDays_BPC01 * 24;
        double back = depotKm_A10 / rTri(mainSpeedMin_A03, mainSpeedMode_A03, mainSpeedMax_A03) + depotPathWait_A10;
        r.bpcKm -= depotKm_A10;
        schedAfter(back, () -> { r.loc = L_CD; setPhase(r, P_WAIT_PATH_CD, -1); qDepartCD.add(r); dispatch(); });
        dispatch();
    });
} else {
    schedAfter(can, () -> examWork(r, remaining - can));
}]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000428</Id>
<Name><![CDATA[chargeDemurrage]]></Name>
<Description><![CDATA[DM-01: Rs/wagon/hour or part over free time, graded slabs (+10% 6-12 h, +25% 12-24 h, +50% 24-48 h, 2x 48-72 h, 3x > 72 h).]]></Description>
<X>2660</X><Y>476</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[hours]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[freeTime]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Parameter>
<Name><![CDATA[loading]]></Name>
<Type><![CDATA[boolean]]></Type>
</Parameter>
<Body><![CDATA[if (time() < statsStart) return;
if (loading) loadEnds++; else unloadEnds++;
double over = hours - freeTime;
if (over <= 1e-9) return;
if (loading) loadOverFree++; else unloadOverFree++;
int h = (int) Math.ceil(over - 1e-9);
double rs = 0;
for (int k = 1; k <= h; k++) {
    double m = k <= 6 ? 1.0 : k <= 12 ? 1.10 : k <= 24 ? 1.25 : k <= 48 ? 1.5 : k <= 72 ? 2.0 : 3.0;
    rs += demurrageRate_DM01 * wagonsPerRake * m;
}
demurrageRs += rs;
demurrageHours += h;
if (loading) demurrageLoadRs += rs; else demurrageUnloadRs += rs;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000429</Id>
<Name><![CDATA[closeCycle]]></Name>
<Description><![CDATA[A rake is back at Ghugus: record the cycle (if it started after warm-up) and write a RAKE_cycle_log row.]]></Description>
<X>2660</X><Y>502</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[r]]></Name>
<Type><![CDATA[Rake]]></Type>
</Parameter>
<Body><![CDATA[setPhase(r, r.phase, -1);
double ct = time() - r.cycleStart;
if (r.cycleStart >= statsStart && statsStart > 0) {
    cyclesDone++;
    sumCycle += ct;
    sumCycleSq += ct * ct;
    cycleTimes.add(ct);
    for (int k = 0; k < NPH; k++) compSum[k] += r.comp[k];
    if (r.reliefThisCycle) reliefCycles++;
    if (r.bpcThisCycle) bpcCycles++;
}
if (writeCycleLog) {
    StringBuilder sb = new StringBuilder();
    sb.append(String.format("CC-%02d,%d", r.id, r.cycleNo));
    int[] cols = { S_ARR_GGS, S_PLACED, S_LOAD_START, S_LOAD_END, S_RELEASED, S_LOCO, S_CREW, S_DEP_GGS,
                   S_ARR_TAE, S_DEP_TAE, S_ARR_CD, S_PLACED_TIP, S_UNLOAD_START, S_UNLOAD_END, S_REL_EMPTY, S_DEP_CD };
    for (int k : cols) sb.append(',').append(r.stamp[k] < 0 ? "" : stampText(r.stamp[k]));
    sb.append(String.format(java.util.Locale.US, ",%.0f,%.1f,%.2f,%s,sim seed %d phase %d scenario %d",
        r.bpcKm, (r.bpcDue - time()) / 24, r.crewHoursLoaded,
        (r.reliefThisCycle ? "crew relief " : "") + (r.bpcThisCycle ? "BPC detour" : ""), seed, cPhase, scenario));
    cycleLog.add(sb.toString());
}]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[String]]></ReturnType>
<Id>1791000000430</Id>
<Name><![CDATA[stampText]]></Name>
<Description><![CDATA[Model hours -> "yyyy-MM-dd HH:mm" (day 0 = 2026-10-05).]]></Description>
<X>2660</X><Y>528</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Parameter>
<Name><![CDATA[t]]></Name>
<Type><![CDATA[double]]></Type>
</Parameter>
<Body><![CDATA[java.time.LocalDateTime d = java.time.LocalDateTime.of(2026, 10, 5, 0, 0).plusSeconds(Math.round(t * 3600));
return String.format("%04d-%02d-%02d %02d:%02d", d.getYear(), d.getMonthValue(), d.getDayOfMonth(), d.getHour(), d.getMinute());]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000431</Id>
<Name><![CDATA[touchStats]]></Name>
<Description><![CDATA[Time-weighted utilisation integrals (called before every kernel event).]]></Description>
<X>2660</X><Y>554</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[double t = time();
double dt = t - lastTouch;
if (dt > 0 && t > statsStart) {
    areaLineDN += (lineBusyDN ? 1 : 0) * dt;
    areaLineUP += (lineBusyUP ? 1 : 0) * dt;
    areaSidings += sidingsBusy * dt;
    areaTipplers += tipplersBusy * dt;
    areaGgsLoops += ggsLoopUsed * dt;
    areaTaeLoops += (taeLoopLoaded + taeLoopEmpty) * dt;
    int onDuty = 0;
    for (Crew c : crews) if (c.rake != null) onDuty++;
    areaCrewOnDuty += onDuty * dt;
    int mq = 0, lq = 0, bp = 0;
    for (Rake r : rakes) {
        if (r.phase == P_WAIT_MERGE_DN) mq++;
        if (r.phase == P_WAIT_PATH_GGS || r.phase == P_WAIT_LINE_TAE) lq++;
        if (r.phase == P_BPC) bp++;
    }
    areaMergeQ += mq * dt; areaLineQ += lq * dt; areaBpc += bp * dt;
    if (mq > maxMergeQ) maxMergeQ = mq;
}
lastTouch = t;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>VOID</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000432</Id>
<Name><![CDATA[resetStats]]></Name>
<Description><![CDATA[End of warm-up (3 days): zero every statistic.]]></Description>
<X>2660</X><Y>580</Y>
<Label><X>10</X><Y>0</Y></Label>
<PublicFlag>false</PublicFlag>
<PresentationFlag>true</PresentationFlag>
<ShowLabel>true</ShowLabel>
<Body><![CDATA[statsStart = time();
lastTouch = time();
delivered = 0; cyclesDone = 0; reliefEvents = 0; extensions = 0; bpcDetours = 0; bpcOverdue = 0; crewTrips = 0;
loadOverFree = 0; unloadOverFree = 0; loadEnds = 0; unloadEnds = 0;
tonnes = 0; sumCycle = 0; sumCycleSq = 0; demurrageRs = 0; demurrageLoadRs = 0; demurrageUnloadRs = 0; demurrageHours = 0;
java.util.Arrays.fill(compSum, 0);
areaLineDN = 0; areaLineUP = 0; areaSidings = 0; areaTipplers = 0; areaGgsLoops = 0; areaTaeLoops = 0; areaCrewOnDuty = 0;
mergeWaitSum = 0; mergeCount = 0; dutySum = 0; reliefCycles = 0; bpcCycles = 0;
areaMergeQ = 0; areaLineQ = 0; areaBpc = 0; maxMergeQ = 0; cycleTimes.clear();
deliveryTimes.clear();
stockMinDays = stockKt / normativeDaily_kt;
daysBelow7 = 0;]]></Body>
</Function>
<Function AccessType="default" StaticFunction="false">
<ReturnModificator>RETURNS_VALUE</ReturnModificator>
<ReturnType><![CDATA[double]]></ReturnType>
<Id>1791000000433</Id>
